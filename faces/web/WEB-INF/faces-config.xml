<?xml version='1.0' encoding='UTF-8'?>
<faces-config version="4.0" xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                                  https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_0.xsd">
    <application>
        <locale-config>
            <default-locale>en</default-locale>
            <supported-locale>de</supported-locale>
            <supported-locale>en</supported-locale>
        </locale-config>
        <resource-bundle>
            <base-name>bravo.web.i18n.messages</base-name>
            <var>msg</var>
        </resource-bundle>
    </application>

    <navigation-rule>
        <from-view-id>*</from-view-id>
        <!-- dashboard points to whatever ends up as our start page after login -->
        <navigation-case>
            <from-outcome>dashboard</from-outcome>
            <to-view-id>/pages/user/timesheetEntry.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
        <navigation-case>
            <from-outcome>entries</from-outcome>
            <to-view-id>/pages/user/timesheetEntry.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
        <navigation-case>
            <from-outcome>contractEdit</from-outcome>
            <to-view-id>/pages/user/contractEdit.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
        <navigation-case>
            <from-outcome>contractList</from-outcome>
            <to-view-id>/pages/user/contractList.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>personForm</from-outcome>
            <to-view-id>/pages/user/personForm.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

        <navigation-case>
            <from-outcome>toLoginForm</from-outcome>
            <to-view-id>/pages/user/login.xhtml</to-view-id>
            <redirect/>
        </navigation-case>

    </navigation-rule>
</faces-config>
